<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Scachalka</AssemblyName>
    <Product>Scachalka</Product>
    <AssemblyTitle>Scachalka</AssemblyTitle>
    <Version>1.2.0</Version>
    <!-- Portable single-file executable (applied on dotnet publish). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Taskbar / Explorer icon for the executable (generated by tools/generate-icon.ps1). -->
    <ApplicationIcon Condition="Exists('..\..\assets\scachalka.ico')">..\..\assets\scachalka.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YtDlpGui.Abstractions\YtDlpGui.Abstractions.csproj" />
    <ProjectReference Include="..\YtDlpGui.Core\YtDlpGui.Core.csproj" />
    <ProjectReference Include="..\YtDlpGui.Infrastructure\YtDlpGui.Infrastructure.csproj" />
    <ProjectReference Include="..\YtDlpGui.Application\YtDlpGui.Application.csproj" />
    <ProjectReference Include="..\YtDlpGui.UI\YtDlpGui.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

</Project>
