<Application x:Class="YtDlpGui.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme first (brush definitions), shared styles second.
                     ThemeManager swaps the theme dictionary at runtime. -->
                <ResourceDictionary Source="pack://application:,,,/YtDlpGui.UI;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/YtDlpGui.UI;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
