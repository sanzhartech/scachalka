<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Control styles shared by both themes. Brushes are DynamicResource so a theme
         swap at runtime restyles the live UI without recreating any control.

         Sizing system (Windows 11-aligned, DPI-safe):
         - One control height for every interactive control, applied as MinHeight so the
           control can never clip its content at 125/150/200% DPI (a fixed Height plus
           vertical padding is what caused the earlier vertical clipping).
         - One corner radius and one input font size across the app. -->

    <sys:Double x:Key="Metric.ControlHeight">34</sys:Double>
    <sys:Double x:Key="Metric.InputFontSize">13</sys:Double>
    <CornerRadius x:Key="Metric.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="Metric.CardCornerRadius">10</CornerRadius>

