<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme palette. Same keys as Dark.xaml — themes are swappable at runtime. -->
    <Color x:Key="Color.Window">#FFF3F3F6</Color>
    <Color x:Key="Color.Panel">#FFFFFFFF</Color>
    <Color x:Key="Color.Card">#FFFFFFFF</Color>
    <Color x:Key="Color.Border">#FFD8D8E0</Color>
    <Color x:Key="Color.Input">#FFFFFFFF</Color>
    <Color x:Key="Color.Text.Primary">#FF1B1B1F</Color>
    <Color x:Key="Color.Text.Secondary">#FF62636C</Color>
    <Color x:Key="Color.Accent">#FF2F6FE4</Color>
    <Color x:Key="Color.Accent.Hover">#FF4A84EF</Color>
    <Color x:Key="Color.Danger">#FFD03538</Color>
    <Color x:Key="Color.Success">#FF2F8A41</Color>
    <Color x:Key="Color.Warning">#FFB07818</Color>
    <Color x:Key="Color.Progress.Track">#FFE3E3EA</Color>
    <Color x:Key="Color.Hover">#FFEAEAF1</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Progress.Track" Color="{StaticResource Color.Progress.Track}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />

</ResourceDictionary>
