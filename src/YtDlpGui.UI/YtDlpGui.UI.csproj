<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YtDlpGui.Abstractions\YtDlpGui.Abstractions.csproj" />
    <ProjectReference Include="..\YtDlpGui.Core\YtDlpGui.Core.csproj" />
    <ProjectReference Include="..\YtDlpGui.Application\YtDlpGui.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <!-- Shared assets embedded as WPF assembly resources -->
  <ItemGroup Condition="Exists('..\..\assets\scachalka.ico')">
    <Resource Include="..\..\assets\scachalka.ico" Link="Assets\scachalka.ico" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Assets\free-icon-link-2985013.png')">
    <Resource Include="Assets\free-icon-link-2985013.png" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('Assets\free-icon-link-2985013.png') and Exists('..\..\assets\free-icon-link-2985013.png')">
    <Resource Include="..\..\assets\free-icon-link-2985013.png" Link="Assets\free-icon-link-2985013.png" />
  </ItemGroup>

</Project>
