<Window x:Class="YtDlpGui.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:YtDlpGui.UI.Converters"
        xmlns:loc="clr-namespace:YtDlpGui.UI.Localization"
        Title="Scachalka"
        Width="980" Height="760"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <Window.Resources>
        <conv:StageToBrushConverter x:Key="StageToBrush" />
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control+Shift" Key="V" Command="{Binding PasteFromClipboardCommand}" />
    </Window.InputBindings>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tools warning banner -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Warning}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding AreToolsReady}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ToolStatusText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Warning}" />
                <Button Grid.Column="1"
                        Content="{loc:Str Tools.Recheck}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding RecheckToolsCommand}"
                        IsEnabled="{Binding IsCheckingTools, Converter={StaticResource InverseBool}}" />
            </Grid>
        </Border>

        <!-- URL input -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Str Url.Hint}"
                           Style="{StaticResource SecondaryText}"
                           Margin="2,0,0,6" />

                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         MinHeight="58" MaxHeight="120"
                         FontSize="13">
                    <TextBox.InputBindings>
                        <KeyBinding Modifiers="Control" Key="Return" Command="{Binding AddUrlsCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                    <Button Content="{loc:Str Btn.AddToQueue}"
                            Style="{StaticResource AccentButton}"
                            MinWidth="130"
                            Command="{Binding AddUrlsCommand}"
                            ToolTip="{loc:Str Btn.AddTooltip}" />
                    <Button Content="{loc:Str Btn.PasteAdd}"
                            MinWidth="130"
                            Margin="0,8,0,0"
                            Command="{Binding PasteFromClipboardCommand}"
                            ToolTip="{loc:Str Btn.PasteTooltip}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Options row -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="{loc:Str Label.Format}" Style="{StaticResource SecondaryText}" Margin="2,0,0,4" />
                    <ComboBox Width="130"
                              ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="{loc:Str Label.Quality}" Style="{StaticResource SecondaryText}" Margin="2,0,0,4" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding Qualities}"
                              SelectedItem="{Binding SelectedQuality}"
                              IsEnabled="{Binding IsQualityEnabled}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="{loc:Str Label.OutputFolder}" Style="{StaticResource SecondaryText}" Margin="2,0,0,4" />
                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" Height="32" />
                </StackPanel>

                <Button Grid.Column="3"
                        Content="{loc:Str Btn.Browse}"
                        VerticalAlignment="Bottom"
                        Height="32"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseFolderCommand}" />
                <Button Grid.Column="4"
                        Content="{loc:Str Btn.OpenFolder}"
                        VerticalAlignment="Bottom"
                        Height="32"
                        Margin="0,0,14,0"
                        Command="{Binding OpenOutputFolderCommand}" />

                <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Str Label.Language}"
                                   Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox Width="104"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}" />
                    </StackPanel>
                    <CheckBox Content="{loc:Str Check.DarkTheme}"
                              HorizontalAlignment="Right"
                              IsChecked="{Binding IsDarkTheme}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Advanced yt-dlp options -->
        <Expander Grid.Row="3"
                  Header="{loc:Str Adv.Header}"
                  Margin="0,0,0,10"
                  IsExpanded="False">
            <Border Background="{DynamicResource Brush.Panel}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,6,0,0">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox Content="{loc:Str Adv.Playlists}"
                                  Margin="0,0,18,6"
                                  IsChecked="{Binding AllowPlaylists}"
                                  ToolTip="{loc:Str Adv.PlaylistsTip}" />
                        <CheckBox Content="{loc:Str Adv.Metadata}"
                                  Margin="0,0,18,6"
                                  IsChecked="{Binding EmbedMetadata}" />
                        <CheckBox Content="{loc:Str Adv.Thumbnail}"
                                  Margin="0,0,18,6"
                                  IsChecked="{Binding EmbedThumbnail}"
                                  ToolTip="{loc:Str Adv.ThumbnailTip}" />
                        <CheckBox Content="{loc:Str Adv.Subtitles}"
                                  Margin="0,0,8,6"
                                  IsChecked="{Binding EmbedSubtitles}"
                                  IsEnabled="{Binding IsSubtitleOptionEnabled}"
                                  ToolTip="{loc:Str Adv.SubtitlesTip}" />
                        <TextBox Width="130"
                                 Height="26"
                                 Margin="0,0,0,6"
                                 Text="{Binding SubtitleLanguages, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding IsSubtitleOptionEnabled}"
                                 ToolTip="{loc:Str Adv.SubLangsTip}" />
                    </WrapPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="{loc:Str Adv.Cookies}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="2,0,0,4"
                                       ToolTip="{loc:Str Adv.CookiesTip}" />
                            <ComboBox Width="140"
                                      ItemsSource="{Binding CookieBrowsers}"
                                      SelectedItem="{Binding SelectedCookiesBrowser}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Str Adv.ExtraArgs}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="2,0,0,4" />
                            <TextBox Height="32"
                                     Text="{Binding CustomArguments, UpdateSourceTrigger=LostFocus}"
                                     FontFamily="Consolas"
                                     ToolTip="{loc:Str Adv.ExtraArgsTip}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Download queue -->
        <Border Grid.Row="4"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="8"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,2,6,8">
                    <TextBlock Text="{loc:Str Queue.Title}" FontWeight="SemiBold" FontSize="14" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconButton}"
                            Content="{loc:Str Queue.ClearFinished}"
                            Command="{Binding ClearFinishedCommand}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Jobs}"
                         ItemContainerStyle="{StaticResource PlainListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="4,3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title + stage chip + actions -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="{Binding Stage, Converter={StaticResource StageToBrush}}"
                                                CornerRadius="9"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StageText}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding FormatText}"
                                                   Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}"
                                                Content="{loc:Str Job.Cancel}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}"
                                                Content="{loc:Str Job.Retry}"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}"
                                                Content="{loc:Str Job.ShowInFolder}"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.OpenJobLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding DisplayName}"
                                               ToolTip="{Binding Url}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13"
                                               Margin="0,7,0,7" />

                                    <!-- Progress + numbers -->
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressBar Grid.Column="0"
                                                     VerticalAlignment="Center"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Str Job.EtaPrefix}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text=" " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EtaText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Error / note line -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding ErrorMessage}"
                                               Foreground="{DynamicResource Brush.Danger}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Log window -->
        <Expander Grid.Row="5"
                  Header="{loc:Str Log.Header}"
                  Margin="0,10,0,0"
                  IsExpanded="False">
            <Border Background="{DynamicResource Brush.Panel}"
                    CornerRadius="8"
                    Padding="6"
                    Margin="0,6,0,0">
                <ListBox Height="150"
                         ItemsSource="{Binding Logs}"
                         ItemContainerStyle="{StaticResource PlainListBoxItem}"
                         FontFamily="Consolas"
                         FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}">
                                <Run Text="{Binding TimeText, Mode=OneWay}" />
                                <Run Text="{Binding LevelText, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <!-- Status bar -->
        <Border Grid.Row="6"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="6"
                Padding="10,6"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" />
        </Border>
    </Grid>
</Window>
