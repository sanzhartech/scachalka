<Window x:Class="YtDlpGui.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:YtDlpGui.UI.Converters"
        xmlns:loc="clr-namespace:YtDlpGui.UI.Localization"
        Title="Scachalka"
        Width="980" Height="760"
        MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <Window.Resources>
        <conv:StageToBrushConverter x:Key="StageToBrush" />
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control+Shift" Key="V" Command="{Binding PasteFromClipboardCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tools warning banner -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Warning}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AreToolsReady}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ToolStatusText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Warning}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Str Tools.Update}"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding UpdateToolsCommand}"
                            IsEnabled="{Binding IsUpdatingTools, Converter={StaticResource InverseBool}}" />
                    <Button Content="{loc:Str Tools.Recheck}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding RecheckToolsCommand}"
                            IsEnabled="{Binding IsCheckingTools, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- URL input -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Str Url.Hint}"
                           Style="{StaticResource SecondaryText}"
                           Margin="2,0,0,6" />

                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         MinHeight="60" MaxHeight="120">
                    <TextBox.InputBindings>
                        <KeyBinding Modifiers="Control" Key="Return" Command="{Binding AddUrlsCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Stretch">
                    <Button Content="{loc:Str Btn.AddToQueue}"
                            Style="{StaticResource AccentButton}"
                            MinWidth="136" Height="34"
                            Command="{Binding AddUrlsCommand}"
                            ToolTip="{loc:Str Btn.AddTooltip}" />
                    <Button Content="{loc:Str Btn.PasteAdd}"
                            MinWidth="136" Height="34"
                            Margin="0,8,0,0"
                            Command="{Binding PasteFromClipboardCommand}"
                            ToolTip="{loc:Str Btn.PasteTooltip}" />
                    <Button Content="{loc:Str Btn.ImportLibrary}"
                            MinWidth="136" Height="34"
                            Margin="0,8,0,0"
                            Command="{Binding ImportLibraryCommand}"
                            IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}"
                            ToolTip="{loc:Str Btn.ImportLibraryTooltip}" />
                    <Button Content="{loc:Str Btn.BulkImport}"
                            MinWidth="136" Height="34"
                            Margin="0,8,0,0"
                            Command="{Binding BulkImportLinksCommand}"
                            IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBool}}"
                            ToolTip="{loc:Str Btn.BulkImportTooltip}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Options panel -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="10"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Captions -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Label.Format}" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Str Label.Quality}" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Str Label.OutputFolder}" Style="{StaticResource FieldLabel}" />

                <!-- Controls -->
                <ComboBox Grid.Row="1" Grid.Column="0"
                          Width="140" Margin="0,0,12,0"
                          ItemsSource="{Binding Formats}"
                          SelectedItem="{Binding SelectedFormat}" />

                <ComboBox Grid.Row="1" Grid.Column="1"
                          Width="150" Margin="0,0,12,0"
                          ItemsSource="{Binding Qualities}"
                          SelectedItem="{Binding SelectedQuality}"
                          IsEnabled="{Binding IsQualityEnabled}" />

                <TextBox Grid.Row="1" Grid.Column="2"
                         Margin="0,0,12,0"
                         Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" />

                <Button Grid.Row="1" Grid.Column="3"
                        Content="{loc:Str Btn.Browse}"
                        Margin="0,0,8,0"
                        Command="{Binding BrowseFolderCommand}" />

                <Button Grid.Row="1" Grid.Column="4"
                        Content="{loc:Str Btn.OpenFolder}"
                        Command="{Binding OpenOutputFolderCommand}" />

                <!-- Auto-update + Language + theme, right-aligned on their own line under the controls -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <CheckBox Content="{loc:Str Check.AutoUpdateOnStartup}"
                              VerticalAlignment="Center"
                              Margin="0,0,24,0"
                              IsChecked="{Binding AutoUpdateOnStartup}" />
                    <TextBlock Text="{loc:Str Label.Language}"
                               Style="{StaticResource SecondaryText}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox Width="132"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}" />
                    <CheckBox Content="{loc:Str Check.DarkTheme}"
                              VerticalAlignment="Center"
                              Margin="24,0,0,0"
                              IsChecked="{Binding IsDarkTheme}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Apple Music library import progress -->
        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="10"
                Padding="14,12"
                Margin="0,0,0,12"
                Visibility="{Binding IsImportPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding ImportStatusText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           VerticalAlignment="Center" />

                <Button Grid.Row="0" Grid.Column="1"
                        Content="{loc:Str Import.Cancel}"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CancelImportCommand}"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding ImportDetailText}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             Height="6"
                             Margin="0,10,0,0"
                             Minimum="0"
                             Maximum="{Binding ImportProgressMax}"
                             Value="{Binding ImportProgressValue, Mode=OneWay}"
                             Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Advanced yt-dlp options -->
        <Expander Grid.Row="4"
                  Header="{loc:Str Adv.Header}"
                  Margin="0,0,0,12"
                  IsExpanded="False">
            <Border Background="{DynamicResource Brush.Panel}"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,8,0,0">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox Content="{loc:Str Adv.Playlists}"
                                  Margin="0,0,20,8"
                                  IsChecked="{Binding AllowPlaylists}"
                                  ToolTip="{loc:Str Adv.PlaylistsTip}" />
                        <CheckBox Content="{loc:Str Adv.Metadata}"
                                  Margin="0,0,20,8"
                                  IsChecked="{Binding EmbedMetadata}" />
                        <CheckBox Content="{loc:Str Adv.Thumbnail}"
                                  Margin="0,0,20,8"
                                  IsChecked="{Binding EmbedThumbnail}"
                                  ToolTip="{loc:Str Adv.ThumbnailTip}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <CheckBox Content="{loc:Str Adv.Subtitles}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      IsChecked="{Binding EmbedSubtitles}"
                                      IsEnabled="{Binding IsSubtitleOptionEnabled}"
                                      ToolTip="{loc:Str Adv.SubtitlesTip}" />
                            <TextBox Width="128"
                                     VerticalAlignment="Center"
                                     Text="{Binding SubtitleLanguages, UpdateSourceTrigger=LostFocus}"
                                     IsEnabled="{Binding IsSubtitleOptionEnabled}"
                                     ToolTip="{loc:Str Adv.SubLangsTip}" />
                        </StackPanel>
                    </WrapPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{loc:Str Adv.Cookies}"
                                   Style="{StaticResource FieldLabel}"
                                   ToolTip="{loc:Str Adv.CookiesTip}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{loc:Str Adv.ExtraArgs}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="14,0,0,5" />

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  Width="150" Margin="0,0,14,0"
                                  ItemsSource="{Binding CookieBrowsers}"
                                  SelectedItem="{Binding SelectedCookiesBrowser}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding CustomArguments, UpdateSourceTrigger=LostFocus}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 ToolTip="{loc:Str Adv.ExtraArgsTip}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Download queue -->
        <Border Grid.Row="5"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="10"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Str Queue.Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconButton}"
                            Content="{loc:Str Queue.ClearFinished}"
                            Command="{Binding ClearFinishedCommand}" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Jobs}"
                         ItemContainerStyle="{StaticResource PlainListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,11"
                                    Margin="4,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title + stage chip + actions -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{Binding Stage, Converter={StaticResource StageToBrush}}"
                                                CornerRadius="10"
                                                Padding="9,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StageText}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding FormatText}"
                                                   Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}"
                                                Content="{loc:Str Job.Cancel}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}"
                                                Content="{loc:Str Job.Retry}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}"
                                                Content="{loc:Str Job.ShowInFolder}"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.OpenJobLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding DisplayName}"
                                               ToolTip="{Binding Url}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13"
                                               Margin="0,9,0,9" />

                                    <!-- Progress + numbers -->
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ProgressBar Grid.Column="0"
                                                     VerticalAlignment="Center"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Str Job.EtaPrefix}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text=" " Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EtaText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Error / note line -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding ErrorMessage}"
                                               Foreground="{DynamicResource Brush.Danger}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Margin="0,7,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Log window -->
        <Expander Grid.Row="6"
                  Header="{loc:Str Log.Header}"
                  Margin="0,12,0,0"
                  IsExpanded="False">
            <Border Background="{DynamicResource Brush.Panel}"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,8,0,0">
                <ListBox Height="150"
                         ItemsSource="{Binding Logs}"
                         ItemContainerStyle="{StaticResource PlainListBoxItem}"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}">
                                <Run Text="{Binding TimeText, Mode=OneWay}" />
                                <Run Text="{Binding LevelText, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <!-- Status bar -->
        <Border Grid.Row="7"
                Background="{DynamicResource Brush.Panel}"
                CornerRadius="8"
                Padding="12,7"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Content="{loc:Str Tools.Update}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding UpdateToolsCommand}"
                        IsEnabled="{Binding IsUpdatingTools, Converter={StaticResource InverseBool}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
